{
  "title": "Rafi's Browser tab navigation: Cmd+j/k",
  "maintainers": ["Rafi"],
  "homepage": "https://github.com/rafi/.config",
	"rules": [
    {
      "description": "Cmd+j/k => Cmd+Option+Up/Down (next/previous tab) in browsers.",
      "manipulators": [
        {
					"description": "Cmd+J => Cmd+Option+Down (only browsers)",
          "type": "basic",
          "from": {
            "key_code": "j",
            "modifiers": { "mandatory": ["command"] }
          },
          "to": [
            {
              "key_code": "down_arrow",
              "modifiers": ["command", "option"]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^app.zen-browser.zen$",
                "^company.thebrowser.Browser$",
                "^com.google.Chrome$",
                "^org.chromium.Chromium",
                "^com.apple.Safari$",
                "^org.mozilla.firefox$",
                "^com.microsoft.edgemac$",
                "^com.brave.Browser$"
              ]
            }
          ]
        },
        {
					"description": "Cmd+K => Cmd+Option+Up (only browsers)",
          "type": "basic",
          "from": {
            "key_code": "k",
            "modifiers": { "mandatory": ["command"] }
          },
          "to": [
            {
              "key_code": "up_arrow",
              "modifiers": ["command", "option"]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^app.zen-browser.zen$",
                "^company.thebrowser.Browser$",
                "^com.google.Chrome$",
                "^org.chromium.Chromium",
                "^com.apple.Safari$",
                "^org.mozilla.firefox$",
                "^com.microsoft.edgemac$",
                "^com.brave.Browser$"
              ]
            }
          ]
        }
      ]
    }
	]
}
