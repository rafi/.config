// https://github.com/pqrs-org/KE-complex_modifications/blob/main/public/json/super-ctrl.json
{
  "title": "Rafi EMACS CTRL S/G/W/X/U/P/N [excluding terminals]",
  "maintainers": ["Rafi"],
  "homepage": "https://github.com/rafi/.config",
  "rules": [
    {
      "description": "CTRL-S => Option+Left (jump word backward) excluding terminals.",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "s",
            "modifiers": { "mandatory": [ "control" ], "optional": [ "any" ] }
          },
          "to": [
            {
              "key_code": "left_arrow",
              "modifiers": [ "option" ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^co\\.zeit\\.hyper$",
                "^com\\.apple\\.Terminal$",
                "^com\\.citrix\\.XenAppViewer$",
                "^com\\.github\\.wez\\.wezterm$",
                "^com\\.googlecode\\.iterm2$",
                "^com\\.ident\\.goneovim$",
                "^com\\.jetbrains",
                "^com\\.microsoft\\.VSCode$",
                "^com\\.microsoft\\.rdc\\.macos$",
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.parallels\\.desktop\\.console$",
                "^com\\.qvacua\\.VimR$",
                "^com\\.sublimetext\\.3$",
                "^com\\.todesktop\\.",
                "^com\\.utmapp\\.UTM$",
                "^com\\.vscodium$",
                "^dev\\.warp$",
                "^io\\.alacritty$",
                "^net\\.kovidgoyal\\.kitty$",
                "^org\\.gnu\\.Emacs$",
                "^org\\.gnu\\.emacs$",
                "^org\\.tabby$",
                "^org\\.vim\\.MacVim$",
                "^org\\.virtualbox\\.app\\.VirtualBoxVM$",
                "^org\\.vmware\\.fusion$"
              ]
            }
          ]
        }
      ]
    },
