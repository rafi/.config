{
  "title": "Rafi's Vim-like navigation: Option+h/j/k/l",
  "maintainers": ["Rafi"],
  "homepage": "https://github.com/rafi/.config",
	"rules": [
		{
			"description": "Vim-like navigation: Option+h/j/k/l",
			"manipulators": [
				{
					"description": "Option+H => Left Arrow (excluding terminals)",
					"type": "basic",
					"from": {
						"key_code": "h",
						"modifiers": { "mandatory": ["left_option"] }
					},
					"to": [{ "key_code": "left_arrow" }],
					"conditions": [
						{
							"bundle_identifiers": [
                "^co\\.zeit\\.hyper$",
                "^com\\.apple\\.Terminal$",
                "^com\\.citrix\\.XenAppViewer$",
                "^com\\.github\\.wez\\.wezterm$",
                "^com\\.googlecode\\.iterm2$",
                "^com\\.ident\\.goneovim$",
                "^com\\.jetbrains",
                "^com\\.microsoft\\.VSCode$",
                "^com\\.microsoft\\.rdc\\.macos$",
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.parallels\\.desktop\\.console$",
                "^com\\.qvacua\\.VimR$",
                "^com\\.sublimetext\\.3$",
                "^com\\.todesktop\\.",
                "^com\\.utmapp\\.UTM$",
                "^com\\.vscodium$",
                "^dev\\.warp$",
                "^io\\.alacritty$",
                "^net\\.kovidgoyal\\.kitty$",
                "^org\\.gnu\\.Emacs$",
                "^org\\.gnu\\.emacs$",
                "^org\\.tabby$",
                "^org\\.vim\\.MacVim$",
                "^org\\.virtualbox\\.app\\.VirtualBoxVM$",
                "^org\\.vmware\\.fusion$"
							],
							"type": "frontmost_application_unless"
						}
					]
				},
				{
					"description": "Option+J => Down Arrow (excluding terminals)",
					"type": "basic",
					"from": {
						"key_code": "j",
						"modifiers": { "mandatory": ["left_option"] }
					},
					"to": [{ "key_code": "down_arrow" }],
					"conditions": [
						{
							"type": "frontmost_application_unless",
							"bundle_identifiers": [
                "^co\\.zeit\\.hyper$",
                "^com\\.apple\\.Terminal$",
                "^com\\.citrix\\.XenAppViewer$",
                "^com\\.github\\.wez\\.wezterm$",
                "^com\\.googlecode\\.iterm2$",
                "^com\\.ident\\.goneovim$",
                "^com\\.jetbrains",
                "^com\\.microsoft\\.VSCode$",
                "^com\\.microsoft\\.rdc\\.macos$",
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.parallels\\.desktop\\.console$",
                "^com\\.qvacua\\.VimR$",
                "^com\\.sublimetext\\.3$",
                "^com\\.todesktop\\.",
                "^com\\.utmapp\\.UTM$",
                "^com\\.vscodium$",
                "^dev\\.warp$",
                "^io\\.alacritty$",
                "^net\\.kovidgoyal\\.kitty$",
                "^org\\.gnu\\.Emacs$",
                "^org\\.gnu\\.emacs$",
                "^org\\.tabby$",
                "^org\\.vim\\.MacVim$",
                "^org\\.virtualbox\\.app\\.VirtualBoxVM$",
                "^org\\.vmware\\.fusion$"
							]
						}
					]
				},
				{
					"description": "Option+K => Up Arrow (excluding terminals)",
					"type": "basic",
					"from": {
						"key_code": "k",
						"modifiers": { "mandatory": ["left_option"] }
					},
					"to": [{ "key_code": "up_arrow" }],
					"conditions": [
						{
							"type": "frontmost_application_unless",
							"bundle_identifiers": [
                "^co\\.zeit\\.hyper$",
                "^com\\.apple\\.Terminal$",
                "^com\\.citrix\\.XenAppViewer$",
                "^com\\.github\\.wez\\.wezterm$",
                "^com\\.googlecode\\.iterm2$",
                "^com\\.ident\\.goneovim$",
                "^com\\.jetbrains",
                "^com\\.microsoft\\.VSCode$",
                "^com\\.microsoft\\.rdc\\.macos$",
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.parallels\\.desktop\\.console$",
                "^com\\.qvacua\\.VimR$",
                "^com\\.sublimetext\\.3$",
                "^com\\.todesktop\\.",
                "^com\\.utmapp\\.UTM$",
                "^com\\.vscodium$",
                "^dev\\.warp$",
                "^io\\.alacritty$",
                "^net\\.kovidgoyal\\.kitty$",
                "^org\\.gnu\\.Emacs$",
                "^org\\.gnu\\.emacs$",
                "^org\\.tabby$",
                "^org\\.vim\\.MacVim$",
                "^org\\.virtualbox\\.app\\.VirtualBoxVM$",
                "^org\\.vmware\\.fusion$"
							]
						}
					]
				},
				{
					"type": "basic",
					"description": "Option+L => Right Arrow (excluding terminals)",
					"from": {
						"key_code": "l",
						"modifiers": { "mandatory": ["left_option"] }
					},
					"to": [{ "key_code": "right_arrow" }],
					"conditions": [
						{
							"type": "frontmost_application_unless",
							"bundle_identifiers": [
                "^co\\.zeit\\.hyper$",
                "^com\\.apple\\.Terminal$",
                "^com\\.citrix\\.XenAppViewer$",
                "^com\\.github\\.wez\\.wezterm$",
                "^com\\.googlecode\\.iterm2$",
                "^com\\.ident\\.goneovim$",
                "^com\\.jetbrains",
                "^com\\.microsoft\\.VSCode$",
                "^com\\.microsoft\\.rdc\\.macos$",
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.parallels\\.desktop\\.console$",
                "^com\\.qvacua\\.VimR$",
                "^com\\.sublimetext\\.3$",
                "^com\\.todesktop\\.",
                "^com\\.utmapp\\.UTM$",
                "^com\\.vscodium$",
                "^dev\\.warp$",
                "^io\\.alacritty$",
                "^net\\.kovidgoyal\\.kitty$",
                "^org\\.gnu\\.Emacs$",
                "^org\\.gnu\\.emacs$",
                "^org\\.tabby$",
                "^org\\.vim\\.MacVim$",
                "^org\\.virtualbox\\.app\\.VirtualBoxVM$",
                "^org\\.vmware\\.fusion$"
							]
						}
					]
				}
			]
		}
	]
}

