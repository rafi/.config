{
  "title": "Rafi's ROption Chord (Right-click/R_Option)",
  "maintainers": ["Rafi"],
  "homepage": "https://github.com/rafi/.config",
  "rules": [
		{
			"description": "R_Option => Right-click (Alone) or R_Option (With other keys).",
			"manipulators": [
				{
					"from": {
						"key_code": "right_option",
						"modifiers": { "optional": ["any"] }
					},
					"to": [{ "key_code": "right_option" }],
					"to_if_alone": [{ "pointing_button": "button2" }],
					"type": "basic"
				}
			]
		}
  ]
}
