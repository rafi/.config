// vim: set ft=json5 ts=4 sw=4 et :
// *********************************************
// ~~## rafi.io                            :@%%~
// ~%@# vscode keybindings.json             @%~~
// *********************************************
[

    // Navigate tabs
    { "key": "cmd+j", "command": "workbench.action.nextEditor" },
    { "key": "cmd+k", "command": "workbench.action.previousEditor" },

    // Move splits
    { "key": "cmd+shift+,", "command": "workbench.action.moveEditorLeftInGroup" },
    { "key": "cmd+shift+.", "command": "workbench.action.moveEditorRightInGroup" },

    // Folds
    {
        "key": "shift+enter",
        "command": "editor.foldAllExcept",
        "when": "vim.active && vim.mode == 'Normal'"
    },

    // Groups
    {
        "key": "ctrl+h",
        "command": "workbench.action.focusLeftGroup",
        "when": "editorTextFocus && multipleEditorGroups && vim.active && vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.focusRightGroup",
        "when": "editorTextFocus && multipleEditorGroups && !activeEditorGroupLast && vim.active && vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.focusAboveGroup",
        "when": "editorTextFocus && multipleEditorGroups && vim.active && vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.focusBelowGroup",
        "when": "editorTextFocus && multipleEditorGroups && vim.active && vim.mode != 'Insert'"
    },

    // Terminal
    {
        "key": "ctrl+/",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+/",
        "command": "workbench.action.terminal.focusNext",
        "when": "!terminalFocus && editorTextFocus && vim.active && vim.mode != 'Insert'"
    },

    // Lists
    {
        "key": "ctrl+h",
        "command": "list.collapse",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "ctrl+l",
        "command": "list.expand",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "ctrl+k",
        "command": "list.focusUp",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "ctrl+j",
        "command": "list.focusDown",
        "when": "listFocus && !inputFocus"
    },

    // Suggestions
    {
        "key": "ctrl+j",
        "command": "selectNextSuggestion",
        "when": "suggestWidgetVisible"
    },
    {
        "key": "ctrl+k",
        "command": "selectPrevSuggestion",
        "when": "suggestWidgetVisible"
    },

    // Quick open
    {
        "key": "ctrl+j",
        "command": "workbench.action.quickOpenSelectNext",
        "when": "inQuickOpen"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.quickOpenSelectPrevious",
        "when": "inQuickOpen"
    },

    // File picker
    {
        "key": "ctrl+j",
        "command": "workbench.action.quickOpenNavigateNextInFilePicker",
        "when": "inFilesPicker && inQuickOpen"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.quickOpenNavigatePreviousInFilePicker",
        "when": "inFilesPicker && inQuickOpen"
    },

    // Explorer
    {
        "key": "ctrl+h",
        "command": "workbench.view.explorer",
        "when": "editorTextFocus && sideBarVisible && activeEditorGroupIndex == 1"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "filesExplorerFocus || outlineFocused"
    },
    {
        "key": "ctrl+j",
        "command": "outline.focus",
        "when": "filesExplorerFocus || outlineFocused"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.explorer.fileView.focus",
        "when": "filesExplorerFocus || outlineFocused"
    },
    {
        "key": "a",
        "command": "explorer.newFile",
        "when": "explorerViewletFocus"
    },
    {
        "key": "r",
        "command": "renameFile",
        "when": "filesExplorerFocus"
    },
    {
        "key": "; e",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "(filesExplorerFocus || sideBarVisible) && !inputFocus"
    },
    {
        "key": "space e",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "(filesExplorerFocus || sideBarVisible) && !inputFocus"
    },

    // Composer Sidebar
    { "key": "cmd+i", "command": "composerMode.agent" },
    {
        "key": "ctrl+h",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "auxiliaryBarFocus || composerFocused"
    },
    {
        "key": "ctrl+l",
        "command": "composerMode.agent",
        "when": "editorTextFocus && (!multipleEditorGroups || activeEditorGroupLast)"
    },

    // Problems Panel
    {
        "key": "ctrl+j",
        "command": "workbench.actions.view.problems",
        "when": "editorTextFocus && panelVisible && (!multipleEditorGroups || activeEditorGroupLast)"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "problemsFilterFocus || panelFocus"
    },
    {
        "key": "space a",
        "command": "workbench.action.togglePanel",
        "when": "panelVisible && vim.active && vim.mode == 'Normal'"
    },
/*     {
        "command": "",
        // "when": "problems"

    }, */

    // Visual mode
    {
        "key": "ctrl+space",
        "command": "editor.action.smartSelect.expand",
        "when": "editorTextFocus && !terminalFocus && vim.active && (vim.mode == 'Visual' || vim.mode == 'Normal')"
    },
    {
        "key": "shift+v",
        "command": "editor.action.smartSelect.shrink",
        "when": "editorTextFocus && !terminalFocus && vim.active && vim.mode == 'Visual'"
    },

]
